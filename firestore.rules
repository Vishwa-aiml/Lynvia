rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Checks if user is an ADMIN (Assuming custom claims are set)
    // Or we can check a 'role' field on their user document
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    
    // --- Users ---
    
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();
      // Only the user themselves can update their user document
      allow write: if isOwner(userId) || isAdmin();
      
      // Subcollections for a user (notifications, preferences, etc.)
      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Projects ---
    
    match /projects/{projectId} {
      // Anyone authenticated can read public projects (e.g. for discovery)
      allow read: if isAuthenticated();
      
      // Only backend should CREATE or UPDATE projects directly to enforce state rules
      // (Clients go through the backend API which bypasses these rules)
      allow write: if false; // Deny all direct client writes
      
      // Subcollections (milestones, tasks, deliveries)
      match /{document=**} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid || 
          get(/databases/$(database)/documents/projects/$(projectId)).data.assignedDesignerId == request.auth.uid
        );
        allow write: if false; // Deny direct client writes, force them through the API
      }
    }
    
    // --- Proposals ---
    
    match /proposals/{proposalId} {
      // Designers can read their own proposals
      // Clients can read proposals for their projects
      allow read: if isAuthenticated() && (
        resource.data.designerId == request.auth.uid ||
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.clientId == request.auth.uid
      );
      
      allow write: if false; // Deny direct client writes
    }
    
    // --- Financials (Payments, Withdrawals, Earnings) ---
    
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.payerId);
      allow write: if false;
    }
    
    match /withdrawals/{withdrawalId} {
      allow read: if isOwner(resource.data.designerId);
      allow write: if false;
    }
    
    match /designerEarnings/{earningId} {
      allow read: if isOwner(resource.data.designerId);
      allow write: if false;
    }
    
    // --- Disputes ---
    
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        resource.data.raisedByUserId == request.auth.uid ||
        resource.data.againstUserId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }
    
    // --- Chat Conversations ---
    
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.clientId == request.auth.uid || 
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.assignedDesignerId == request.auth.uid
      );
      allow write: if false;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.projectId)).data.clientId == request.auth.uid || 
          get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.projectId)).data.assignedDesignerId == request.auth.uid
        );
        allow write: if false;
      }
    }

  }
}
